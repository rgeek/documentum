    <build>
        <finalName>stp-SearchPoc-1.0.0</finalName>
        <plugins>
            <plugin>
                <groupId>com.emc.xcp.builder</groupId>
                <artifactId>xcp-import-project</artifactId>
                <version>1.0.6</version>
                <configuration>
                    <mavenRepoPath>maven/designer</mavenRepoPath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.emc.xcp.builder</groupId>
                <artifactId>xcp-validate</artifactId>
                <version>1.0.14</version>
                <executions>
                    <execution>
                        <id>xcp-validate</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <dir>${basedir}/Artifacts</dir>
                    <mavenRepoPath>maven/designer</mavenRepoPath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>add-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>gen/main/java</source>
                            </sources>
                        </configuration>
                    </execution>
                    <execution>
                        <id>add-resource</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>add-resource</goal>
                        </goals>
                        <configuration>
                            <resources>
                                <resource>
                                    <directory>gen/main/resources</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.emc.xcp.builder</groupId>
                <artifactId>xcp-generate-sources</artifactId>
                <version>1.0.11</version>
                <executions>
                    <execution>
                        <id>xcp-generate-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <dir>${basedir}/Artifacts</dir>
                    <mavenRepoPath>maven/designer</mavenRepoPath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.2.2</version>
                <configuration>
                    <archive>
                        <manifestFile>META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                    <webResources>
                        <resource>
                            <directory>Artifacts</directory>
                            <includes>
                                <include>Resources/*</include>
                            </includes>
                            <targetPath>Artifacts</targetPath>
                        </resource>
                        <resource>
                            <directory>lib</directory>
                            <includes>
                                <include>**/*.jar</include>
                            </includes>
                            <targetPath>WEB-INF/lib</targetPath>
                        </resource>
                        <resource>
                            <directory>gen/main/webapp</directory>
                            <includes>
                                <include>**/*</include>
                            </includes>
                        </resource>
                    </webResources>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.emc.xcp.builder</groupId>
                <artifactId>xcp-dar</artifactId>
                <version>1.0.13</version>
                <executions>
                    <execution>
                        <id>xcp-dar</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <dir>${basedir}/Artifacts</dir>
                    <mavenRepoPath>maven/designer</mavenRepoPath>
                    <executionEnvironment>
                        <groupId>com.emc.executionenvironment</groupId>
                        <artifactId>xcp</artifactId>
                        <version>24.2.1000.0157</version>
                    </executionEnvironment>
                    <Manifest>
                        <Bundle-ClassPath>.</Bundle-ClassPath>
                    </Manifest>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.emc.xcp.builder</groupId>
                <artifactId>xcp-deploy</artifactId>
                <version>1.0.15</version>
                <executions>
                    <execution>
                        <id>xcp-deploy</id>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <envId>${envId}</envId>
                    <dataPolicy>${dataPolicy}</dataPolicy>
                    <deploymentMethod>${deploymentMethod}</deploymentMethod>
                    <repositoryServicesOnly>${repositoryServicesOnly}</repositoryServicesOnly>
                    <envConfigFile>${envConfigFile}</envConfigFile>
                    <appConfigFile>${appConfigFile}</appConfigFile>
                    <parameters>
                        <com.emc.executionenvironment.xcp.xPlore.xploreAsyncIndexing>${com.emc.executionenvironment.xcp.xPlore.xploreAsyncIndexing}</com.emc.executionenvironment.xcp.xPlore.xploreAsyncIndexing>
                    </parameters>
                    <vmArgs>-Xms512m -Xmx768m</vmArgs>
                    <mavenRepoPath>maven/designer</mavenRepoPath>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>2.7</version>
                <executions>
                    <execution>
                        <id>default-deploy</id>
                        <phase>deploy</phase>
                        <goals>
                            <goal>deploy</goal>
                        </goals>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>2.3.emcpatch</version>
                <configuration>
                    <forcedPlugins>
                        <param>org.apache.maven.plugins:maven-surefire-plugin:2.7.1</param>
                        <param>org.apache.maven.surefire:surefire-junit3:2.10</param>
                        <param>org.apache.maven.surefire:surefire-providers:2.10:pom</param>
                    </forcedPlugins>
                </configuration>
                <executions>
                    <execution>
                        <id>patched-maven-dependency-plug-in</id>
                        <goals>
                            <goal>go-offline</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
