<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://documentum.emc.com/2010/UI-Model" xmlns:xcp="http://documentum.emc.com/xcp/2010"
        id="rwd_custom_tree_view" xtype="rwd_custom_tree_view" 
        version="1.0.0000.001">

    <name>Custom Tree View</name>
    <description>A custom tree view</description>
    <author email="rahul.narula@coforge.com">Rahul Narula</author>

    
	<icon src="icons/contenttree_wig.png" width="16" height="16"/> <!-- palette -->
    <icon src="icons/contenttree_24_wig.png" width="24" height="24"/> <!-- drag-and-drop -->

    <content src="content/tro/widgets/CustomTreeView.js" type="text/javascript"/>
    <content src="content/tro/widgets/design/CustomTreeView.js" type="text/javascript" mode="design"/>
    
    <category>xcpPalette:Custom</category>

    <configuration>
    	
		
		
		<propertyInfo name="cabinetFilter" required="true">
            <type>EXPRESSION</type>
            <expression>
                <setterFunName>setFilter</setterFunName>
                <contextTree>
                    <include>PRIMARY_CONTEXT</include>
                	<include>APP_CONTEXT</include>
                	<include>WIDGET_CONTEXT</include>
                	<include>DATASOURCE_OUTPUT</include>
                	<include>SINGLE_OBJECT_DATA_SERVICE_OUTPUT</include>
                </contextTree>
            </expression>
        </propertyInfo>
        
		<propertyInfo name="debug">
			<label>Debug</label>
			<type>BOOLEAN</type>
			<defaultvalue>false</defaultvalue>
		</propertyInfo>

        <propertyInfo name="fieldLabel" localizable="true">
            <label>Label</label>
            <type>STRING</type>
            <constraint>
	            <validator type="maxLength" maxLength="60"/>
            </constraint>
            <required>true</required>
			<defaultvalue>Label</defaultvalue>
        </propertyInfo>

        
        <propertyInfo name="readOnly">
            <label>Read-only when</label>
            <type>EXPRESSION</type>
            <expression>
                <setterFunName>setReadOnly</setterFunName>
                <contextTree>
                    <include>PRIMARY_CONTEXT</include>
                    <include>APP_CONTEXT</include>
                    <include>WIDGET_CONTEXT</include>
                </contextTree>
            </expression>
        </propertyInfo>
        
        <propertyInfo name="hidden">
            <label>Hidden when</label>
            <type>EXPRESSION</type>
            <expression>
                <setterFunName>setHidden</setterFunName>
                <contextTree>
                    <include>PRIMARY_CONTEXT</include>
                    <include>APP_CONTEXT</include>
                    <include>WIDGET_CONTEXT</include>
                </contextTree>
            </expression>
        </propertyInfo>
	</configuration>
	
	<expressionProperties>
        <propertyInfo name="selectedNodeId">
            <label>Selected Node ID</label>
            <getterFun>
                <name>rwd.widgets.CustomTreeView.getSelectedNodeId</name>
                <arguments>
                    <argument>EVALUATION_CONTEXT</argument>
                    <argument>WIDGET_ID</argument>
                </arguments>
            </getterFun>
            <changeEvents>
                <eventInfo name="change"/>
            </changeEvents>
        </propertyInfo>
    </expressionProperties>

   

    <methods/>

    <events>
        <eventInfo name="change">change</eventInfo>
    </events>

</widget>
