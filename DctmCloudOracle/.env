# 24.4 image from dockerimages-values.yaml - same image serves Postgres and Oracle
CS_IMAGE=registry.opentext.com/ot-dctm-server:24.4

HOST_IP=127.0.0.1

DOCBASE_NAME=ecmdev_ora
DOCBASE_NAME_UPPER=ECMDEV_ORA
DOCBASE_ID=453217

# Pluggable DB service of the XE container
ORACLE_SERVICE=XEPDB1

# 16+ chars each
DATABASE_PASSWORD=Password_#123
ROOT_PASSWORD=EcmdevCs@2024
INSTALL_OWNER_PASSWORD=Ecmdctmcoe@July2026
DOCBASE_PASSWORD=Ecmdctmcoe@July2026
GLOBAL_REGISTRY_PASSWORD=Ecmdctmbof@July2026
AEK_PASSPHRASE=
APP_SERVER_PASSWORD=AppServerPassword@12345

# Process Engine: set true only after enabling step 8 in Dockerfile
ENABLE_PE=true


# Documentum Administrator (preferences / presets repository passwords)
DA_PREFERENCE_PASSWORD=EcmdctmPref@July2026
DA_PRESET_PASSWORD=EcmdctmPreset@July2026
