# 24.4 image from dockerimages-values.yaml - same image serves Postgres and Oracle
CS_IMAGE=registry.opentext.com/ot-dctm-server:24.4

HOST_IP=127.0.0.1

DOCBASE_NAME=ecmdev_ora
DOCBASE_NAME_UPPER=ECMDEV_ORA
DOCBASE_ID=453217

# Pluggable DB service of the XE container
ORACLE_SERVICE=XEPDB1

# 16+ chars each
DATABASE_PASSWORD=ChangeMe_Oracle0001
ROOT_PASSWORD=ChangeMe_RootPass01
INSTALL_OWNER_PASSWORD=ChangeMe_dmadmin001
DOCBASE_PASSWORD=ChangeMe_Docbase0001
GLOBAL_REGISTRY_PASSWORD=ChangeMe_GlobalReg01
AEK_PASSPHRASE=ChangeMe_AEKpass00001
APP_SERVER_PASSWORD=ChangeMe_AppServer01

# Process Engine: set true only after enabling step 8 in Dockerfile.cs-ora
ENABLE_PE=false

# Documentum Administrator (preferences / presets repository passwords)
DA_PREFERENCE_PASSWORD=ChangeMe_DaPref0001
DA_PRESET_PASSWORD=ChangeMe_DaPreset001
